    "code": "import asyncio\nimport json\nimport sys\nimport time\n\n\nasync def scan_host_port(host, port, semaphore, timeout=1.5):\n    \"\"\"Asynchronously checks the status of a specific port on a host,\n\n    measuring the Round Trip Time (RTT) in milliseconds.\n    \"\"\"\n    async with semaphore:\n        start_time = time.perf_counter()\n        try:\n            # Attempt to establish a TCP connection within the timeout limit\n            reader, writer = await asyncio.wait_for(\n                asyncio.open_connection(host, port), timeout=timeout\n            )\n            elapsed = time.perf_counter() - start_time\n            writer.close()\n            try:\n                await writer.wait_closed()\n            except Exception:\n                pass  # Ignore errors during connection teardown\n\n            return {\n                \"host\": host,\n                \"port\": port,\n                \"status\": \"open\",\n                \"rtt_ms\": round(elapsed * 1000, 2),\n            }\n        except (asyncio.TimeoutError, OSError, ConnectionRefusedError):\n            elapsed = time.perf_counter() - start_time\n            return {\n                \"host\": host,\n                \"port\": port,\n                \"status\": \"closed\",\n                \"rtt_ms\": round(elapsed * 1000, 2),\n            }\n\n\nasync def main():\n    # Target range configured for the specified local subnet\n    subnet_prefix = \"30.30.30.\"\n    hosts = [f\"{subnet_prefix}{i}\" for i in range(1, 51)]\n    ports = [22, 80, 443, 8006]\n\n    # Limit concurrent connections to 30 to prevent socket exhaustion\n    semaphore = asyncio.Semaphore(30)\n\n    tasks = []\n    for host in hosts:\n        for port in ports:\n            tasks.append(scan_host_port(host, port, semaphore))\n\n    # Run all connection checks concurrently\n    results = await asyncio.gather(*tasks)\n\n    # Output the results as a valid JSON array\n    print(json.dumps(results, indent=2))\n\n\nif __name__ == \"__main__\":\n    # Ensure compatibility with Windows event loop policies if running on Windows\n    if sys.platform == \"win32\":\n        asyncio.set_event_loop_policy(asyncio.WindowsSelectorEventLoopPolicy())\n\n    asyncio.run(main())",
